{
  "name": "cytos-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "electron electron/main.mjs",
    "app:dev": "CYTOS_DEV_URL=http://localhost:5173 electron electron/main.mjs",
    "make": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "io.github.gitbamboo42.cytos",
    "productName": "cytos",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "npmRebuild": false,
    "mac": {
      "target": "dir",
      "category": "public.app-category.medical",
      "identity": null
    }
  },
  "dependencies": {
    "@deck.gl/core": "~9.3.3",
    "@deck.gl/geo-layers": "~9.3.3",
    "@deck.gl/layers": "~9.3.3",
    "@deck.gl/react": "~9.3.3",
    "@hms-dbmi/viv": "^0.22.1",
    "@math.gl/core": "^4.1.0",
    "apache-arrow": "^21.2.0",
    "parquet-wasm": "^0.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zarrita": "^0.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
